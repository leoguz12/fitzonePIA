# Copia este archivo a .env y ajusta los valores:   cp .env.example .env
# NUNCA subas el archivo .env a GitHub (está en .gitignore). Aquí NO hay secretos reales.

# --- Aplicación ---
APP_ENV=development
APP_PORT=8000

# --- Base de datos ---
# Local sin Docker (SQLite):
DATABASE_URL=sqlite:///./fitzone.db
# Con docker compose, la app arma su URL con estas variables:
POSTGRES_USER=fitzone
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=fitzone
POSTGRES_TEST_DB=fitzone_test

# --- Reglas de negocio configurables (supuestos del BRD, sección 9) ---
TOLERANCIA_MINUTOS=10
LIMITE_CANCELACION_HORAS=2
TARIFA_MENSUAL=600.00
TARIFA_TRIMESTRAL=1500.00
TARIFA_ANUAL=5000.00
TARIFA_SESION_ENTRENAMIENTO=300.00

# --- Demo ---
# true = al arrancar con la BD vacía crea socios, instructores y clases de ejemplo
SEED_DEMO_DATA=true
