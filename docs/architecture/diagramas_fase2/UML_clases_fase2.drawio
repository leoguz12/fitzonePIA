        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Socio {\n        +int idSocio\n        +String nombre\n        +String estatus\n        +identificarse()\n    }\n\n    class Membresia {\n        +int idMembresia\n        +Date fechaInicio\n        +Date fechaVencimiento\n        +String estatus\n        +validarVigencia()\n    }\n\n    class PlanContratado {\n        +int idPlan\n        +String tipo\n        +verificarInclusiones()\n    }\n\n    class ClaseEspecial {\n        +int idClase\n        +String nombre\n        +int capacidadMaxima\n        +int cuposDisponibles\n        +consultarAforo()\n    }\n\n    class Reserva {\n        +int idReserva\n        +Date fecha\n        +String estatus\n        +confirmarReserva()\n        +cancelarReserva()\n        +registrarNoShow()\n    }\n\n    class ListaEspera {\n        +int idLista\n        +int posicion\n        +agregarSocio()\n        +asignarLugarAutomatico()\n    }\n\n    class Instructor {\n        +int idInstructor\n        +String nombre\n        +cancelarSesion()\n        +consultarHorario()\n    }\n\n    class Pago {\n        +int idPago\n        +float monto\n        +String concepto\n        +registrarCobro()\n    }\n\n    Socio \&quot;1\&quot; -- \&quot;1\&quot; Membresia : posee\n    Membresia \&quot;1\&quot; -- \&quot;1\&quot; PlanContratado : determina\n    Socio \&quot;1\&quot; -- \&quot;*\&quot; Reserva : realiza\n    Reserva \&quot;*\&quot; -- \&quot;1\&quot; ClaseEspecial : aparta\n    ClaseEspecial \&quot;1\&quot; -- \&quot;1\&quot; ListaEspera : tiene\n    Instructor \&quot;1\&quot; -- \&quot;*\&quot; ClaseEspecial : imparte\n    Reserva \&quot;1\&quot; -- \&quot;0..1\&quot; Pago : genera (si fuera de plan)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="qmhThqVzYRZZsgYuVIj3-1">
